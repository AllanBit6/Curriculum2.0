---
const { social } = Astro.props;
---

<aside class="col-span-2 flex flex-col gap-10 md:w-[90%] w-full md:items-start items-center">
  <!--Info section -->
  <div class="flex flex-col gap-5 md:w-[60%] w-[90%] md:items-start items-center">
    <!--Profile image-->
    <div
      class="bg-white h-50 w-50 rounded-2xl flex items-center justify-center shadow-lg shadow-[#e34d0a]/50"
    >
      <img src="/profile.png" class="w-full h-full object-cover rounded-2xl" />
    </div>
    <!--Profile info-->
    <div class="flex flex-col md:text-left text-center">
      <h1 class="font-sans font-bold md:text-3xl text-4xl text-white">Allan Vasquez</h1>
      <h2 class="text-(--prg-color) md:text-[16px] text-[20px]">Junior Full Stack Developer</h2>
    </div>
    <div class="flex lg:flex-row flex-col items-center gap-2">
      <i class="fa-solid fa-globe-americas text-(--prg-color)"></i>
      <p class="text-(--prg-color) text-[14px] md:text-left text-center">Totonicapan, Guatemala</p>
    </div>
    <div class="">
      <ul class="flex flex-row justify-between">
        {
          social.map((s: any) => {
            return (
              <li class="p-1 rounded-[10px] hover:bg-white/10">
                <a href={s.url}>
                  <i class={s.svg + " text-(--primary-color) text-2xl"} />
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>

  <!-- About Section -->
  <div>
    <div class="flex flex-col gap-10 md:w-[85%] w-full">
      <h1 class="text-white text-3xl">Sobre mi</h1>
      <p class="text-(--prg-color) text-[14px] text-justify">
        Desarrollador full stack junior enfocado en crear aplicaciones web
        funcionales. Busco crecer profesionalmente y aportar soluciones claras
        dentro de un equipo de desarrollo.
      </p>
    </div>
  </div>
</aside>
