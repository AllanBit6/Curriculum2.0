---
const { social } = Astro.props;
---

<aside class="col-span-2 flex flex-col gap-10 w-[90%]">
  <!--Info section -->
  <div class="flex flex-col gap-5 w-[60%]">
    <!--Profile image-->
    <div
      class="bg-white h-50 w-50 rounded-2xl flex items-center justify-center shadow-lg shadow-[#e34d0a]/50"
    >
      <img src="/profile.png" class="w-full h-full object-cover rounded-2xl" />
    </div>
    <!--Profile info-->
    <div class="flex flex-col">
      <h1 class="font-sans font-bold text-3xl text-white">Allan Vasquez</h1>
      <h2 class="text-(--prg-color)">Junior Full Stack Developer</h2>
    </div>
    <div class="flex flex-row items-center gap-2">
      <i class="fa-solid fa-globe-americas text-(--prg-color)"></i>
      <p class="text-(--prg-color) text-[14px]">Totonicapan, Guatemala</p>
    </div>
    <div class="">
      <ul class="flex flex-row justify-between">
        {
          social.map((s: any) => {
            return (
              <li class="p-1 rounded-[10px] hover:bg-white/10">
                <a href={s.url}>
                  <i class={s.svg + " text-(--primary-color) text-2xl"} />
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>

  <!-- About Section -->
  <div>
    <div class="flex flex-col gap-10 w-[85%]">
      <h1 class="text-white text-3xl">About</h1>
      <p class="text-(--prg-color) text-[14px]">
        Junior Full Stack Developer with a passion for building web
        applications. Currently seeking opportunities to further develop my
        skills in a professional setting.
      </p>
    </div>
  </div>
</aside>
