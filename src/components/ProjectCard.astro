---
const {title, repo, url, description, tech} = Astro.props;
---

<div class ="flex flex-col border gap-3 border-(--prg-color) rounded-[10px] bg-white/5 p-3">
    <!--Project Header -->
    <div>
        <img src=""/>
        <h3 class ="text-white text-[16px]">{title}</h3>
    </div>
    <!--Project description -->
    <div>
        <p class="text-(--prg-color) text-[14px]">{description}</p>
    </div>
    <!--Project skills -->
    <div>
        <ul class ="ml-10 gap-1 flex flex-col">
            {tech.map(
            (t:any) => {
                return(
                    <li class="text-(--prg-color) text-[14px] list-disc">{t}</li>
                )})
            }
        </ul>
        
    </div>

</div>