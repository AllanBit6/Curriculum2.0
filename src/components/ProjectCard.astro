---
const {title, repo, url, description, tech, langs} = Astro.props;
---

<div class ="flex flex-col border gap-5 border-(--prg-color) rounded-[10px] bg-white/5 p-3">
    <!--Project Header -->
    <div class ="flex flex-row gap-3 items-center">
        <i class="fa-regular fa-folder text-white text-[17px]"></i>
        <h3 class ="text-white text-[17px] hover:text-(--primary-color) hover:cursor-pointer"><a href={url}>{title}</a></h3>
        <a href={repo}><i class="fa-brands fa-git-alt text-white text-[18px] hover:text-(--primary-color) hover:cursor-pointer"></i></a>
    </div>
    <!--Project description -->
    <div>
        <p class="text-(--prg-color) text-[14px]">{description}</p>
    </div>
    <!--Project skills -->
    <div>
        <ul class ="ml-5 gap-1 flex flex-col">
            {tech.map(
            (t:any) => {
                return(
                    <li class="text-(--prg-color) text-[14px] list-disc">{t}</li>
                )})
            }
        </ul>
    </div>
    <div>
        <ul class ="flex flex-row gap-2 flex-wrap">
            {
                    langs.map(
                        (l:any) =>{return(
                        <i class = {l + " px-3 py-1 rounded-[10px] border border-(--primary-color) bg-(--primary-color)/20 text-(--primary-color) text-[15px]"}></i>)})
            }
        </ul>
    </div>

</div>