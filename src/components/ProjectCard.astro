---
const { title, repo, url, description, tech, langs } = Astro.props;
---

<div
  class="grid grid-rows-9 items-start border gap-3 border-(--prg-color) rounded-[10px] bg-white/3 p-3"
>
  <!--Project Header -->
  <div class="row-span-2 flex flex-row gap-3 items-center align-top">
    <i class="fa-regular fa-folder text-white text-[17px]"></i>
    <h3
      class="text-white md:text-[18px] text-[20px] hover:text-(--primary-color) hover:cursor-pointer"
    >
      <a href={url}>{title}</a>
    </h3>
    <a href={repo}
      ><i
        class="fa-brands fa-git-alt text-white text-[18px] hover:text-(--primary-color) hover:cursor-pointer"
      ></i></a
    >
  </div>
  <!--Project description -->
  <div class="row-span-3">
    <p class="text-(--prg-color) text-[14px] text-justify">{description}</p>
  </div>
  <!--Project skills -->
  <div class="row-span-3">
    <ul class="ml-5 gap-1 flex flex-col">
      {
        tech.map((t: any) => {
          return <li class="text-(--prg-color) text-[14px] list-disc">{t}</li>;
        })
      }
    </ul>
  </div>
  <!--Project features -->
  <div class="row-span-1">
    <ul class="flex flex-row gap-2 flex-wrap">
      {
        langs.map((l: any) => {

          let color = "";
          switch(l.type){
              
              case "collab": 
                color = "--blue-color"
                break;
              case "deploy": 
                color = "--success-color"
                break;
              case "learning": 
                color = "--yellow-color"
                break;
              case "lang": 
                color = "--primary-color"
                break;
          }
          return (
              <i class={l.icon+" px-3 py-1 rounded-[10px] border border-() bg-("+color+")/20 text-("+ color+") text-[15px]"}/>)})
      }
    </ul>
  </div>
</div>
