---
import ExperienceCard from "../components/ExperienceCard.astro";
import ProjectCard from "../components/ProjectCard.astro";

const {experiences, projects, skills} = Astro.props;
---


<article class ="col-span-4 md:w-[95%] w-full">
				<div class="flex flex-col gap-20 w-full">
					<!--Experiences block-->
					<div class ="flex flex-col gap-10">
						<h2 class ="text-white text-3xl">Experience</h2>
						<div class ="flex flex-col gap-5">
							{experiences.map(
								(ex:any)=>{
									return(
										<div>
											<hr class ="w-[25%] m-3 border-1/2 border-(--prg-color)"/>
											<ExperienceCard date={ex.date}
												title={ex.title}
												location={ex.location}
												enterprise={ex.enterprise}
												summary={ex.summary}
												responsabilities={ex.responsabilities}
												achievements={ex.achievements}
												skills={ex.skills}
												url={ex.url}/>
										</div>
									)
								}
							)}
						</div>	
					</div>

					<!--Projects block-->
					<div class ="flex flex-col gap-10 w-full">
						<h2 class ="text-white text-3xl">Projects</h2>
						<div class ="grid lg:grid-cols-2 md:grid-cols-1 gap-3">

							{
								projects.map(
									(p:any)=>{return(
											<ProjectCard 
														title={p.title}
										 				description={p.description}
										 				tech={p.tech}
														url={p.url},
														repo={p.repo}
										 				langs={p.langs}/>)})
							}
						</div>

					</div>

					<!--Skills block -->
					<div class="flex flex-col gap-10 w-full">
						<h2 class ="text-white text-3xl">Skills</h2>

						<div class="flex flex-row flex-wrap gap-10">
							{
								skills.map(
									(m:any) => {
										return(
										<div class ="flex flex-row gap-1 items-center">
											<i class = {m[1] + " text-2xl text-(--primary-color)"}></i>
											<p class ="text-(--prg-color)">{m[0]}</p>
										</div>
									)})

							}
						</div>
					</div>
			</article>