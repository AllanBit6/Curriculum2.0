---
import ExperienceCard from "../components/ExperienceCard.astro";
import ProjectCard from "../components/ProjectCard.astro";

const {experiences, projects, skills, education, certificates} = Astro.props;
---


<article class ="col-span-4 md:w-[95%] w-full">
				<div class="flex flex-col gap-20 w-full">
					<!--Experiences block-->
					<div class ="flex flex-col gap-10">
						<h2 class ="text-white text-3xl">Experience</h2>
						<div class ="flex flex-col gap-5">
							{experiences.map(
								(ex:any)=>{
									return(
										<div>
											<hr class ="w-[25%] m-3 border-1/2 border-(--prg-color)"/>
											<ExperienceCard date={ex.date}
												title={ex.title}
												location={ex.location}
												enterprise={ex.enterprise}
												summary={ex.summary}
												responsabilities={ex.responsabilities}
												achievements={ex.achievements}
												skills={ex.skills}
												url={ex.url}/>
										</div>
									)
								}
							)}
						</div>	
					</div>

					<!--Projects block-->
					<div class ="flex flex-col gap-10 w-full">
						<h2 class ="text-white text-3xl">Projects</h2>
						<div class ="grid lg:grid-cols-2 md:grid-cols-1 gap-3">

							{
								projects.map(
									(p:any)=>{return(
											<ProjectCard 
														title={p.title}
										 				description={p.description}
										 				tech={p.tech}
														url={p.url},
														repo={p.repo}
										 				langs={p.langs}/>)})
							}
						</div>

					</div>

					<!--Skills block -->
					<div class="flex flex-col gap-10 w-full">
						<h2 class ="text-white text-3xl">Skills</h2>

						<div class="lg:flex lg:flex-row lg:flex-wrap gap-10 grid grid-cols-2">
							{
								skills.map(
									(m:any) => {
										return(
										<div class ="flex flex-row gap-1 items-center">
											<i class = {m[1] + " text-2xl text-(--primary-color)"}></i>
											<p class ="text-(--prg-color)">{m[0]}</p>
										</div>
									)})

							}
						</div>
					</div>

					<!--Education block -->
					<div class="flex flex-col gap-10 w-full">
						<h2 class ="text-white text-3xl">Education</h2>

						<!--Education cards-->
						<div class="flex flex-col gap-5">
							{
								education.map(
									(ed:any) => {
										return(
											<div class ="md:grid md:grid-cols-10 flex flex-col items-left justify-center">
												<div class="col-span-8 flex flex-row gap-5">
													<i class="fa-solid fa-graduation-cap text-white text-[20px]"></i>
													<div class="flex flex-col">
														<a href={ed.url}>
															<p class="text-white font-bold hover:text-(--primary-color)">{ed.school}</p>
														</a>														
														<p class="text-(--prg-color)">{ed.grade}</p>
													</div>
													
												</div>
												<div class="col-span-2 flex flex-row-reverse">
													<p class="text-(--prg-color)">{ed.time}</p>
												</div>
											</div>
										)})

							}
							
						</div>
						
					</div>

					<!--Certificates and diplomas block -->
					<div class="flex flex-col gap-10 w-full">
						<h2 class ="text-white text-3xl">Certificates and Diplomas</h2>

						<!--Diplomas cards-->
						<div class="flex flex-col gap-5">
							{
								certificates.map(
									(c:any) => {
										return(
											<div class ="md:grid md:grid-cols-10 flex flex-col items-left justify-center">
												<div class="col-span-8 flex flex-row gap-5">
													<i class="fa-solid fa-award text-white text-[20px]"></i>
													<div class="flex flex-col">
														<a href={c.url}>
															<p class="text-white font-bold hover:text-(--primary-color)">{c.name}</p>
														</a>														
														<p class="text-(--prg-color)">{c.platform}</p>
													</div>
													
												</div>
												<div class="col-span-2 flex flex-row-reverse">
													<p class="text-(--prg-color)">{c.time}</p>
												</div>
											</div>
										)})

							}
							
						</div>
						
					</div>

			</article>