---
import Layout from "../layouts/Layout.astro";
import ExperienceCard from "../components/ExperienceCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import "../styles/global.css";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.


//Edit svg colors on file src/assets/
const social = [
	{
		name: "LinkedIn",
		svg: "fa-brands fa-linkedin",
		url:""
	},
	{
		name: "GitHub",
		svg: "fa-brands fa-github",
		url:""
	},
	{
		name: "Gmail",
		svg: "fa-solid fa-inbox",
		url:""
	},
	{
		name: "WhatsApp",
		svg: "fa-brands fa-whatsapp" ,
		url:""
	}

]

const experiences = [
		{
		title:"Freelance Fullstack developer", 
        date:"2026-Now", 
        enterprise:"Code-QX",
        location:"Home Office", 
        url:"#", 
        summary:"Creation of an own software development studio, speciality developing administration software for start-ups and growing enterprises.", 
        responsabilities:["Meetings and requirements setup for client and his needs", "Leader and product owner (SCRUM) for the dev-team", "New releases/features meeting and demonstrations with client"], 
        achievements:["Achievement 1", "Achievement 2", "Achievement 3"],
        skills:["React JS", "Tailwind CSS", "Python Django", "Vite", "Github", "Trello", "Communication", "Planning", "Persuasion"]
	},
	{
		title:"Customer Tech Support Rep", 
        date:"2025-2026", 
        enterprise:"Telus Digital Xela",
        location:"Quetzaltenango, Guatemala", 
        url:"#", 
        summary:"In charge of giving remote support to users of a package company website via cellphone.", 
        responsabilities:["New accounts setup guidance", "Documentation and pending-tickets solving", "Workaround providing for many situations related to the website."], 
        achievements:["Selected to be part of that new LBO wave (wave 3) in Guatemala"],
        skills:["English", "Multi-task", "Tickets management", "Under-Pressure work"]
	},
	{
		title:"IT and Programming Teacher", 
        date:"2023-2025", 
        enterprise:"Instituto Tecnologico Teczion",
        location:"Totonicapan, Guatemala", 
        url:"#", 
        summary:"Lorem ipsum dolor sit amet consectetur adipisicing elit. Sed voluptatibus laboriosam molestiae assumenda, optio distinctio voluptates vero possimus voluptate, minima facere quo? Reiciendis dignissimos vero maiores molestias possimus id cum.", 
        responsabilities:["Responsability 1", "Responsability 1", "Responsability 1"], 
        achievements:["Achievement 1", "Achievement 2", "Achievement 3"],
        skills:["React", "Tailwind", "Vite", "Github", "Trello", "Communication", "Planning", "Persuasion"]
	}
]

---

<Layout>
	<div class ="p-15">
		<main class="grid grid-cols-6 min-h-screen">
			<aside class = "col-span-2 flex flex-col gap-10 w-[90%]">

				<!--Info section -->
				<div class = "flex flex-col gap-5 w-[60%]">
					<!--Profile image-->
					<div class="bg-white h-50 w-50 rounded-2xl flex items-center justify-center shadow-lg shadow-[#e34d0a]/50">
						<img src="/profile.png" class="w-full h-full object-cover rounded-2xl"/>
					</div>
					<!--Profile info-->
					<div class ="flex flex-col">
						<h1 class ="font-sans font-bold text-3xl text-white">Allan Vasquez</h1>
						<h2 class ="text-(--prg-color)">Junior Full Stack Developer</h2>
					</div>
					<div class="flex flex-row items-center gap-2">
						<i class="fa-solid fa-globe-americas text-(--prg-color)"></i>
						<p class ="text-(--prg-color) text-[14px]">Totonicapan, Guatemala</p>
					</div>
					<div class ="">
						<ul class ="flex flex-row justify-between">
							{
								social.map(
									(s) =>{
										return(
										<li class ="p-1 rounded-[10px] hover:bg-white/10">
											<a href={s.url}>
												<i class={s.svg + " text-(--primary-color) text-2xl"}></i>	
											</a>
										</li>
									)
									}
								)

							}
						</ul>
					</div>
				</div>

				<!-- About Section -->
				<div>
					<div class ="flex flex-col gap-10 w-[85%]">
						<h1 class="text-white text-3xl">About</h1>
						<p class="text-(--prg-color) text-[14px]">
							Junior Full Stack Developer with a passion for
							building web applications. Currently 
							seeking opportunities to further develop 
							my skills in a professional setting.
						</p>
					</div>
				</div>		
				
			</aside>

			<article class ="col-span-4 w-[95%]">
				<div class="flex flex-col gap-20">
					<!--Experiences block-->
					<div class ="flex flex-col gap-10">
						<h2 class ="text-white text-3xl">Experience</h2>
						<div class ="flex flex-col gap-5">
							{experiences.map(
								(ex)=>{
									return(
										<div>
											<hr class ="w-[25%] m-3 border-1/2 border-(--prg-color)"/>
											<ExperienceCard date={ex.date}
												title={ex.title}
												location={ex.location}
												enterprise={ex.enterprise}
												summary={ex.summary}
												responsabilities={ex.responsabilities}
												achievements={ex.achievements}
												skills={ex.skills}
												url={ex.url}/>
										</div>
									)
								}
							)}
						</div>	
					</div>

					<!--Projects block-->
					<div class ="flex flex-col gap-10">
						<h2 class ="text-white text-3xl">Projects</h2>
						<div class ="grid grid-cols-2 gap-3">
							<ProjectCard title="Project 1"
										 description="Lorem ipsum, dolor sit amet consectetur adipisicing elit. Repellendus quae maxime quis ducimus, mollitia non vitae sapiente consequatur illo! Ipsam eveniet iusto delectus numquam illo suscipit tempore nostrum quibusdam voluptates!"
										 tech={[1,2,3,4,5]}/>
							<ProjectCard title="Project 1"
										 description="Lorem ipsum, dolor sit amet consectetur adipisicing elit. Repellendus quae maxime quis ducimus, mollitia non vitae sapiente consequatur illo! Ipsam eveniet iusto delectus numquam illo suscipit tempore nostrum quibusdam voluptates!"
										 tech={[1,2,3,4,5]}/>
							
	
					</div>
				</div>
			</article>
			
		</main>

	</div>
</Layout>
