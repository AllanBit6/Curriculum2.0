---
import Layout from "../layouts/Layout.astro";
import ExperienceCard from "../components/ExperienceCard.astro";
import "../styles/global.css";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.


//Edit svg colors on file src/assets/
const social = [
	{
		name: "LinkedIn",
		svg: "/src/assets/linkedin.svg",
		url:""
	},
	{
		name: "GitHub",
		svg: "/src/assets/github.svg",
		url:""
	},
	{
		name: "Gmail",
		svg: "/src/assets/mail.svg",
		url:""
	},
	{
		name: "WhatsApp",
		svg: "/src/assets/whatsapp.svg",
		url:""
	}

]

const experiences = [
	{
		title:"Customer Tech Support Rep", 
        date:"2025-2026", 
        enterprise:"Telus Digital",
        location:"Quetzaltenango, Guatemala", 
        url:"", 
        summary:"Lorem ipsum dolor sit amet consectetur adipisicing elit. Sed voluptatibus laboriosam molestiae assumenda, optio distinctio voluptates vero possimus voluptate, minima facere quo? Reiciendis dignissimos vero maiores molestias possimus id cum.", 
        responsabilities:["Responsability 1", "Responsability 1", "Responsability 1"], 
        achievements:["Achievement 1", "Achievement 2", "Achievement 3"],
        skills:["English", "Multi-task", "Tickets management", "Under-Pressure work"]
	},
	{
		title:"Customer Tech Support Rep", 
        date:"2025-2026", 
        enterprise:"Telus Digital",
        location:"Quetzaltenango, Guatemala", 
        url:"", 
        summary:"Lorem ipsum dolor sit amet consectetur adipisicing elit. Sed voluptatibus laboriosam molestiae assumenda, optio distinctio voluptates vero possimus voluptate, minima facere quo? Reiciendis dignissimos vero maiores molestias possimus id cum.", 
        responsabilities:["Responsability 1", "Responsability 1", "Responsability 1"], 
        achievements:["Achievement 1", "Achievement 2", "Achievement 3"],
        skills:["py, cpp, cs, css, java, js, ts, rct"]
	},
	{
		title:"Customer Tech Support Rep", 
        date:"2025-2026", 
        enterprise:"Telus Digital",
        location:"Quetzaltenango, Guatemala", 
        url:"", 
        summary:"Lorem ipsum dolor sit amet consectetur adipisicing elit. Sed voluptatibus laboriosam molestiae assumenda, optio distinctio voluptates vero possimus voluptate, minima facere quo? Reiciendis dignissimos vero maiores molestias possimus id cum.", 
        responsabilities:["Responsability 1", "Responsability 1", "Responsability 1"], 
        achievements:["Achievement 1", "Achievement 2", "Achievement 3"],
        skills:["py, cpp, cs, css, java, js, ts, rct"]
	}
]

---

<Layout>
	<div class ="p-15">
		<main class="grid grid-cols-6 min-h-screen">
			<aside class = "col-span-2 flex flex-col gap-10 w-[90%]">

				<!--Info section -->
				<div class = "flex flex-col gap-5 w-[60%]">
					<!--Profile image-->
					<div class="bg-white h-50 w-50 rounded-2xl flex items-center justify-center shadow-lg shadow-[#e34d0a]/50">
						<img src="/src/assets/profile.png" class="w-full h-full object-cover rounded-2xl"/>
					</div>
					<!--Profile info-->
					<div class ="flex flex-col">
						<h1 class ="font-sans font-bold text-3xl text-white">Allan Vasquez</h1>
						<h2 class ="text-(--prg-color)">Junior Full Stack Developer</h2>
					</div>
					<div>
						<span></span>
						<p class ="text-(--prg-color) text-[14px]">Totonicapan, Guatemala</p>
					</div>
					<div class ="">
						<ul class ="flex flex-row justify-between">
							{
								social.map(
									(s) =>{
										return(
										<li class ="p-1 rounded-[10px] hover:bg-white/10">
											<a href={s.url}>
												<svg class="" height="30" width="30">
													<image class="" height="30" width="30" href={s.svg} />
												</svg>		
											</a>
										</li>
									)
									}
								)

							}
						</ul>
					</div>
				</div>

				<!-- About Section -->
				<div>
					<div class ="flex flex-col gap-10 w-[85%]">
						<h1 class="text-white text-3xl">About</h1>
						<p class="text-(--prg-color) text-[14px]">
							Junior Full Stack Developer with a passion for
							building web applications. Currently 
							seeking opportunities to further develop 
							my skills in a professional setting.
						</p>
					</div>
				</div>		
				
			</aside>

			<article class ="col-span-4 w-[95%]">
				<div>
					<!--Experiences block-->
					<div class ="flex flex-col gap-10">
						<h2 class ="text-white text-3xl">Experiences</h2>
						<div class ="flex flex-col gap-5">
							{experiences.map(
								(ex)=>{
									return(
										<ExperienceCard date={ex.date}
											title={ex.title}
											location={ex.location}
											enterprise={ex.enterprise}
											summary={ex.summary}
											responsabilities={ex.responsabilities}
											achievements={ex.achievements}
											skills={ex.skills}/>
									)
								}
							)}
						</div>
						
					</div>
				</div>
				
			</article>
		</main>

	</div>
</Layout>
